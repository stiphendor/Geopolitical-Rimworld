<Operation Class="PatchOperationFindMod">
    <mods>
        <li>Vanilla Expanded Framework</li>
    </mods>
    <match Class="PatchOperationFindMod">
        <mods>
            <li>Advanced Biomes (Continued)</li>
        </mods>
            <match Class="PatchOperationSequence">
                <operations>
            <li Class="PatchOperationAdd">
                <xpath>/Defs/FactionDef[defName="Anarchistes" or defName="Anarchistes_feministes" or defName="Anarchiste_communiste" or defName="ukraine"]/modExtensions/li[@Class="VFECore.FactionDefExtension"]/allowedBiomes</xpath>
                <value>
                                <li>Wasteland</li>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>/Defs/FactionDef[defName="australia" or defName="chretiens" or defName="ecolos" or defName="ecolos_radicaux" or defName="terroristes_islamistes" or defName="musulmans"]/modExtensions/li[@Class="VFECore.FactionDefExtension"]/allowedBiomes</xpath>
                <value>
                                <li>Savanna</li>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>/Defs/FactionDef[defName="bresil"]/modExtensions/li[@Class="VFECore.FactionDefExtension"]/allowedBiomes</xpath>
                <value>
                                <li>Savanna</li>
                                <li>Wetland</li>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>/Defs/FactionDef[defName="usa" or defName="france" or defName="mexique" or defName="Moines_bouddhistes" or defName="russie"]/modExtensions/li[@Class="VFECore.FactionDefExtension"]/allowedBiomes</xpath>
                <value>
                                <li>Volcano</li>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>/Defs/FactionDef[defName="britain"]/modExtensions/li[@Class="VFECore.FactionDefExtension"]/allowedBiomes</xpath>
                <value>
                                <li>Wetland</li>
                </value>
            </li>
                </operations>
            </match>
        </match>
</Operation>


