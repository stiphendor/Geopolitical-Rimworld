<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ScenarioDef Name="Buddhists">
    <defName>scenario_buddhists</defName>
    <label>Nouvelle colonie bouddhiste</label>
    <description>Trois bouddhistes fondent une nouvelle colonie en accord avec leurs croyances.</description>
    <scenario>
      <summary>Trois bouddhistes fondent une nouvelle colonie en accord avec leurs croyances.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>buddhistsfactionplayer</factionDef>
      </playerFaction>
      <parts>

        <!-- Config pages -->
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>

        <!-- Player starting stuff spawn method-->
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        
        <!-- Player starting things -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealFine_Veg</thingDef>
          <count>50</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>50</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Geopol_gun</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Geopol_Qiang</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Geopol_Wingchun</thingDef>
        </li>
	<li Class="ScenPart_StartingAnimal">
		<def>StartingAnimal</def>
		<animalKind>Yak</animalKind>
		<count>1</count>
	</li>
	<li MayRequire="VanillaExpanded.VAEEndAndExt" Class="ScenPart_StartingAnimal">
		<def>StartingAnimal</def>
		<animalKind>AEXP_Panda</animalKind>
		<count>1</count>
	</li>

        <!-- Scatter some things near player start -->
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Steel</thingDef>
          <count>150</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>WoodLog</thingDef>
          <count>450</count>
        </li>      

        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>7</count>
        </li>
        
      </parts>
    </scenario>
  </ScenarioDef>



</Defs>
