      <generalSettings>
        <humanRecipeImport>true</humanRecipeImport>
	<maleGenderProbability>0.5</maleGenderProbability>
        <alienPartGenerator>
	<colorChannels Inherit="False">
		<li>
		<name>skin</name>
		<first Class="ColorGenerator_Options">
		<options>
		<li>
			<weight>1</weight>
			<only>RGB(0.538, 0.312, 0.023, 1.0)</only>
		</li>
		</options>
		</first>
		<second Class="ColorGenerator_Single">
			<color>RGBA(1.0, 1.0, 1.0, 1.0)</color>
		</second>
		</li>
		<li>                           
		<name>hair</name>
		<first Class="ColorGenerator_Options">
		 <options><!--Hair Colors--> 
		<li>					
			<weight>33</weight>
			<only>RGBA(0.104, 0.098, 0.074, 1.0)</only>
		</li>
		<li>					
			<weight>33</weight>
			<only>RGBA(0.186, 0.168, 0.074, 1.0)</only>
		</li>
		<li>					
			<weight>33</weight>
			<only>RGBA(0.108, 0.068, 0.058, 1.0)</only>
		</li>
		</options>
		</first>
		<second Class="ColorGenerator_Single">
		<color>RGBA(1.0, 1.0, 1.0, 1.0)</color>
		</second>
		</li>
	</colorChannels>
        </alienPartGenerator>
      </generalSettings>
	<raceRestriction>
		<blackEndoCategories>
			<li>Melanin</li>
			<li>HairColor</li>
		</blackEndoCategories>
	</raceRestriction>
    </alienRace>
</AlienRace.ThingDef_AlienRace>

</Defs>
