<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <ThingDef ParentName="Gilet_pare_balles">
    <defName>Geopol_mexique_gpb</defName>
    <label>Gilet pare-balles mexicain</label>
    <description>Gilets pare-balles mexicain.</description>
    <graphicData>
      <texPath>Apparel/Mexique/Gpb/mexique_gpb_display</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	<apparel>
      <wornGraphicPath>Apparel/Mexique/Gpb/mexique_gpb</wornGraphicPath>
	</apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_mexicain</li>
	<li MayRequire="VanillaExpanded.VAPPE">VAE_MilitaryClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

