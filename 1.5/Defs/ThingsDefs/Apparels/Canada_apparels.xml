  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_bucheron</defName>
    <label>Chemise de bûcheron</label>
    <description>Symbole du bûcheron canadien viril, cette chemise à carreaux rouge et noir sera l'attribut idéal pour vous accompagner lors de vos séances de bûcheronnage à la hache ou d'un combat contre un ours.</description>
    <graphicData>
      <texPath>Apparel/Canada/Bucheron/preview_bucheron</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
      <costList>
	<Cloth>60</Cloth>
      </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>2800</WorkToMake>
      <Mass>0.5</Mass>
      <Insulation_Cold>15</Insulation_Cold>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Canada/Bucheron/bucheron</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_canada</li>
	<li>ComplexClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


  
</Defs>