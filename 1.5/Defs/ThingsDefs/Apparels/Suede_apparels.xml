<ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_Parka</defName>
    <label>parka moderne</label>
    <description>Une parka moderne synthétique permettant de rester au chaud même lors des hivers les plus rigoureux.</description>
    <graphicData>
      <texPath>Apparel/Suede/Parka/display_chest</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costStuffCount>140</costStuffCount>
    <stuffCategories>
      <li>synthetic</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToMake>12000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>3.00</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.00</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
