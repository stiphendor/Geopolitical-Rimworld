<?xml version="1.0" encoding="utf-8" ?>
<Defs>

 <!-- Black Suit -->

    <ThingDef ParentName="ApparelMakeableBase">
        <defName>Geopol_Costume_cravate_noir</defName>
        <label>Costume cravate noir</label>
        <description>Un costume cravate de couleur noire, porté par toute personne attentive à renvoyer une image sérieuse d'elle. Porter ce vêtement aidera à être pris au sérieux lors de négociations notamment commerciales.</description>
        <graphicData>
        <texPath>Apparel/Black_suit/Costume_noir</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.90</drawSize>
        </graphicData>
        <techLevel>Industrial</techLevel>
            <costList>
	       <Cloth>100</Cloth>
            </costList>
	    <thingCategories>
	      <li>ApparelMisc</li>
	    </thingCategories>
        <statBases>
        <MaxHitPoints>120</MaxHitPoints>
        <WorkToMake>8000</WorkToMake>
        <Mass>0.3</Mass>
        <Insulation_Cold>8.0</Insulation_Cold>
        <EquipDelay>3</EquipDelay>
        </statBases>
            <equippedStatOffsets>
                <SocialImpact>0.25</SocialImpact>
	        <TradePriceImprovement>0.05</TradePriceImprovement>
		<SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
            </equippedStatOffsets>
        <apparel>
        <bodyPartGroups>
            <li>Torso</li>
            <li>Shoulders</li>
            <li>Arms</li>
            <li>Legs</li>
        </bodyPartGroups>
        <wornGraphicPath>Apparel/Black_suit/Black_Suit</wornGraphicPath>
        <layers>
            <li>OnSkin</li>
        </layers>
        <tags>
            <li>costume</li>
        </tags>
        <defaultOutfitTags>
            <li>Worker</li>
        </defaultOutfitTags>
        </apparel>
	<recipeMaker>
	        <researchPrerequisites>
			<li>ComplexClothing</li>
			<li MayRequire="VanillaExpanded.VAPPE">VAE_FormalWear</li>
	        </researchPrerequisites>
		<skillRequirements>
			<Crafting>5</Crafting>
		</skillRequirements>
	</recipeMaker>
    </ThingDef>


