<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <ThingDef ParentName="Gilet_pare_balles">
    <defName>Geopol_france_gpb</defName>
    <label>Gilet pare-balles français</label>
    <description>Gilets pare-balles français.</description>
    <graphicData>
      <texPath>Apparel/France/Gpb/france_gpb_display</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	<apparel>
      <wornGraphicPath>Apparel/France/Gpb/france_gpb</wornGraphicPath>
	</apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_france</li>
	<li MayRequire="VanillaExpanded.VAPPE">VAE_MilitaryClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

 <ThingDef ParentName="Treillis_militaire">
