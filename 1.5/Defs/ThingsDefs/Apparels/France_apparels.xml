    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_france</li>
	<li MayRequire="VanillaExpanded.VAPPE">VAE_MilitaryClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

 <ThingDef ParentName="Casque_militaire">
    <defName>Geopol_france_casque</defName>
    <label>Casque français</label>
    <description>Casque français.</description>
    <graphicData>
      <texPath>Apparel/France/Casque/preview_france_casque</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <apparel>
      <wornGraphicPath>Apparel/France/Casque/france_casque</wornGraphicPath>
