  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_mariniere</defName>
    <label>Marinière</label>
    <description>La marinière est un vêtement en coton à rayures horizontales bleues et blanches. Historiquement portés par les marins, la marinière est aujourd'hui un vêtement caractéristique de la mode française.</description>
    <graphicData>
      <texPath>Apparel/France/Mariniere/preview_Mariniere</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
      <costList>
	<Cloth>50</Cloth>
      </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.3</Mass>
      <Insulation_Cold>4.0</Insulation_Cold>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
          <SocialImpact>0.05</SocialImpact>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/France/Mariniere/Mariniere</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_france</li>
	<li>ComplexClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


   <ThingDef ParentName="HatMakeableBase">
    <defName>Geopol_france_beret</defName>
    <label>Béret</label>
    <description>Le béret est le couvre-chef emblématique de la culture française.</description>
    <graphicData>
      <texPath>Apparel/France/Beret/preview_beret</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
    </graphicData>
    <costStuffCount>25</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>1600</WorkToMake>
      <MaxHitPoints>70</MaxHitPoints>
      <Mass>0.1</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
          <SocialImpact>0.05</SocialImpact>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/France/Beret/beret</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
       <li>france</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_france</li>
	<li>ComplexClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


  
</Defs>