  <ThingDef ParentName="HatMakeableBase">
    <defName>Geopol_casquette_ny</defName>
    <label>Casquette NY</label>
    <description>La légendaire casquette NY typique de la culture américaine.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Apparel/Usa/Casquette/casquette_ny_display</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <shaderType>CutoutComplex</shaderType>
	  <drawSize>1.5</drawSize>
    </graphicData>
    <stuffCategories>
	  <li>Fabric</li>
	  <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <statBases>
      <WorkToMake>1600</WorkToMake>
      <MaxHitPoints>70</MaxHitPoints>
      <Mass>0.1</Mass>
      <StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>0.8</EquipDelay>
    </statBases>
    <apparel>
	<countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
	    <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Usa/Casquette/casquette_ny</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <tags>
        <li>Usa</li>
      </tags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>6</weight>
          <only>(0.24,0.24,0.24)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.554,0.662,0.596)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.26,0.33,0.33)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.702,0.64,0.59)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.598,0.81,0.86)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.314,0.374,0.338)</only>
        </li>
       <li>
          <weight>3</weight>
          <only>(0.766,0.19,0.19)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_usa</li>
	<li>ComplexClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_jean</defName>
    <label>jean</label>
    <description>Le jean est un pantalon plus solide que le pantalon classique à la couleur caractéristique bleu clair, popularisé aux Etats-Unis à partir du 19ème par Levi Strauss. Cette matière est particulièrement résistante au temps.</description>
    <graphicData>
      <texPath>Apparel/Usa/Jean/preview_Jean</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
      <costList>
           <Cloth>50</Cloth>
      </costList>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>2000</WorkToMake>
      <Mass>0.5</Mass>
	<ArmorRating_Blunt>0.3</ArmorRating_Blunt>
	<Insulation_Cold>5</Insulation_Cold>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <wornGraphicPath>Apparel/Usa/Jean/Jean</wornGraphicPath>
      <tags>
        <li>Jean</li>
        <li>Usa</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_usa</li>
	<li>ComplexClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>



  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_jean_vest</defName>
    <label>veste en jean</label>
    <description>Une veste en jean. Introduit aux États-Unis à la fin du 19e siècle, elle a été un type de vêtement décontracté populaire auprès des hommes et des femmes et est devenue un élément emblématique de la mode américaine. Cette matière est particulièrement résistante au temps.</description>
    <graphicData>
      <texPath>Apparel/Usa/Jean vest/preview_Veste_jean</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
      <costList>
           <Cloth>80</Cloth>
      </costList>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <WorkToMake>10000</WorkToMake>
      <Mass>1.7</Mass>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <Insulation_Cold>10</Insulation_Cold>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Usa/Jean vest/Veste_jean</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Usa</li>
	<li>australien</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_usa</li>
	<li>ComplexClothing</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

  
</Defs>