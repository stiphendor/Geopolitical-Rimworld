  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_britain_tenue_reine</defName>
    <label>tenue de la Reine</label>
    <description>Tenue portée par la Reine d'Angleterre.</description>
    <graphicData>
      <texPath>Apparel/Britain/Reine/display_reine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>synthetic</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToMake>10000</WorkToMake>
      <Mass>0.75</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.2</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <equippedStatOffsets>
          <SocialImpact>0.25</SocialImpact>
          <TradePriceImprovement>0.05</TradePriceImprovement>
          <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
     <gender>Female</gender>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Britain/Reine/chest</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
       <li>reine</li>
      </tags>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>ComplexClothing</li>
	<li>Geopol_research_grandebretagne</li>
      </researchPrerequisites>
    </recipeMaker>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>3</weight>
          <only>(0.37,0.78,0.94)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.57,0.01,0.80)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.99,0.28,0.59)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.96,0.21,0.16)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.92,0.83,0.22)</only>
        </li>
        <li>
          <weight>3</weight>
          <only>(0.23,0.90,0.25)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>


