      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_Juif_tenue_homme</defName>
    <label>tenue juive (homme)</label>
    <description>Tenue traditionnelle juive portée par les hommes.</description>
    <graphicData>
      <texPath>Apparel/Juifs/Tenue/preview_Tenue_juive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
        <costList>
           <Cloth>80</Cloth>
        </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>2800</WorkToMake>
      <Mass>0.75</Mass>
        <Insulation_Cold>5.0</Insulation_Cold>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
          <SocialImpact>0.05</SocialImpact>
          <TradePriceImprovement>0.05</TradePriceImprovement>
    </equippedStatOffsets>
    <thingCategories>
      <li>vetements_religieux</li>
    </thingCategories>
    <apparel>
      <gender>Male</gender>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Juifs/Tenue/Tenue</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
       <li>juifs</li>
      </tags>
	<canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_juif</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


