<?xml version="1.0" encoding="utf-8" ?>
<Defs>
   <ThingDef ParentName="HatMakeableBase">
    <defName>Geopol_Juif_chapeau</defName>
    <label>Chapeau juif</label>
    <description>Un chapeau traditionel porté par les hommes juifs.</description>
    <graphicData>
      <texPath>Apparel/Juifs/Chapeau/Chapeau</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
        <costList>
           <Cloth>25</Cloth>
        </costList>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.3</Mass>
      <EquipDelay>0.8</EquipDelay>
    </statBases>
      <equippedStatOffsets>
          <SocialImpact>0.05</SocialImpact>
      </equippedStatOffsets>
    <thingCategories>
      <li>couvre_chef_religieux</li>
    </thingCategories>
    <apparel>
      <gender>Male</gender>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Juifs/Chapeau/Chapeau_juif</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
       <li>juifs</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_juif</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

   <ThingDef ParentName="HatMakeableBase">
    <defName>Geopol_Juif_schtreimel</defName>
    <label>Schtreimel</label>
    <description>Le schtreimel est un chapeau de fourrure porté par de nombreux Juifs, plus particulièrement par des membres de groupes hassidiques, pendant le shabbat, les fêtes religieuses et autres célébrations. Porter ce couvre-chef aide à garder la tête froide en toutes circonstances.</description>
    <graphicData>
      <texPath>Apparel/Juifs/Schtreimel/preview_Schtreimel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>45</costStuffCount>
    <stuffCategories>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>2000</WorkToMake>
      <Mass>0.3</Mass>
      <EquipDelay>0.8</EquipDelay>
    </statBases>
      <equippedStatOffsets>
          <SocialImpact>0.05</SocialImpact>
	<MentalBreakThreshold>-0.2</MentalBreakThreshold>
	<PsychicSensitivity>-0.2</PsychicSensitivity>
      </equippedStatOffsets>
    <thingCategories>
      <li>couvre_chef_religieux</li>
    </thingCategories>
    <apparel>
      <gender>Male</gender>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Juifs/Schtreimel/Schtreimel</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
       <li>juifs_schtreimel</li>
      </tags>
	<canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_juif</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


