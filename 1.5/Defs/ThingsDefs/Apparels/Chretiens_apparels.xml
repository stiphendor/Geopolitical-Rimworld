   <ThingDef ParentName="HatMakeableBase">
    <defName>Geopol_Chretien_Calotte</defName>
    <label>Calotte</label>
    <description>La calotte est une coiffe ronde, portée par les ecclésiastiques dans la liturgie catholique. C'est un signe d'humilité rappelant qu'il y a toujours quelqu'un au dessus de nous, porter ce couvre-chef aide à garder la tête froide en toutes circonstances.</description>
    <graphicData>
      <texPath>Apparel/Juifs/Kippa/preview_kippa</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>15</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToMake>1000</WorkToMake>
      <Mass>0.1</Mass>
      <EquipDelay>0.5</EquipDelay>
    </statBases>
      <equippedStatOffsets>
	<MentalBreakThreshold>-0.1</MentalBreakThreshold>
	<PsychicSensitivity>-0.1</PsychicSensitivity>
      </equippedStatOffsets>
    <thingCategories>
      <li>couvre_chef_religieux</li>
    </thingCategories>
    <apparel>
      <gender>Male</gender>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Juifs/Kippa/kippa</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
       <li>calotte</li>
      </tags>
	<canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_chretien</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


