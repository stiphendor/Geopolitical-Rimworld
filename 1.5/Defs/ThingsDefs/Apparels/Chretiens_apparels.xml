<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_soutane_nonne</defName>
    <label>soutane de nonne</label>
    <description>Une soutane de nonne chrétienne. Cette soutane est accompagnée d'une petite croix en bois. Porter ce vêtement aide à garder la tête froide en toutes circonstances.</description>
    <graphicData>
      <texPath>Apparel/Chretiens/Nonne/display_nonne</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
        <costList>
           <Cloth>80</Cloth>
           <WoodLog>1</WoodLog>
        </costList>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>2000</WorkToMake>
      <Mass>0.75</Mass>
      <Insulation_Cold>10</Insulation_Cold>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
	<MentalBreakThreshold>-0.1</MentalBreakThreshold>
	<PsychicSensitivity>-0.1</PsychicSensitivity>
    </equippedStatOffsets>
    <thingCategories>
      <li>vetements_religieux</li>
    </thingCategories>
    <apparel>
      <gender>Female</gender>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Chretiens/Nonne/Nonne</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
	  <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_chretien</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

