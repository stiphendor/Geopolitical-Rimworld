<?xml version="1.0" encoding="utf-8" ?>
<Defs>

   <ThingDef ParentName="ApparelMakeableBase">
    <defName>Geopol_djellaba</defName>
    <label>Djellaba</label>
    <description>La djellaba est une longue robe ample portée par les hommes et les femmes, répandue comme vêtement traditionnel en Afrique du Nord. Porter ce vêtement aide à garder la tête froide en toutes circonstances.</description>
    <graphicData>
      <texPath>Apparel/Islamic/Djellaba/preview_Djellaba</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
    <costStuffCount>70</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
	<thingCategories>
	<li>vetements_religieux</li>
	</thingCategories>
    <statBases>
	<MaxHitPoints>100</MaxHitPoints>
	<WorkToMake>1800</WorkToMake>
      <Mass>0.25</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
    </statBases>
      <equippedStatOffsets>
	<MentalBreakThreshold>-0.1</MentalBreakThreshold>
	<PsychicSensitivity>-0.1</PsychicSensitivity>
      </equippedStatOffsets>
	<apparel>
	<bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
	<li>Shoulders</li>
        <li>Arms</li>
	<li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Apparel/Islamic/Djellaba/Djellaba</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>musulmans</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_islam</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


