     <texPath>Weapons/Rifle/C7A1</texPath>
     <graphicClass>Graphic_Single</graphicClass>
   </graphicData>
    <equippedAngleOffset>40</equippedAngleOffset>
   <weaponTags>
     <li>Canada_fusil</li>
   </weaponTags>
