<Defs>

<ThingDef ParentName="Geopol_pistol">
    <defName>Geopol_Fort_17c</defName>
    <label>Pistolet Fort 17</label>
    <description>Le pistolet Fort-17, conçu en Ukraine, allie robustesse et précision. Compact et fiable, il est idéal pour le combat rapproché et les missions tactiques exigeantes.</description>
    <graphicData>
      <texPath>Weapons/Pistol/Fort_17</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	<weaponTags>
     <li>Ukraine_pistolet</li>
    </weaponTags>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_ukraine</li>
	<li>BlowbackOperation</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>

<ThingDef ParentName="Geopol_rifle">
   <defName>Geopol_AK74c</defName>
   <label>Fusil d'assaut AK-74</label>
   <description>L'AK-74 est un fusil d'assaut mis en service par l'Union soviétique en 1974, pour remplacer l'AKM par une arme de plus petit calibre qui puisse offrir les mêmes avantages que le M16 américain.</description>
   <graphicData>
     <texPath>Weapons/Rifle/AK74</texPath>
     <graphicClass>Graphic_Single</graphicClass>
   </graphicData>
   <equippedAngleOffset>40</equippedAngleOffset>
   <weaponTags>
     <li>Ukraine_fusil</li>
   </weaponTags>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_russie</li>
	<li>PrecisionRifling</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
</ThingDef>

<ThingDef ParentName="Geopol_rifle">
    <defName>Geopol_ZbroyarZ15c</defName>
    <label>Zbroyar Z-15</label>
    <description>Le Zbroyar Z-15 est un fusil d’assaut ukrainien moderne, précis et modulaire. Léger et fiable, il excelle en combat rapproché comme à moyenne portée, parfait pour les opérations tactiques.</description>
    <graphicData>
      <texPath>Weapons/Rifle/Zbroyar_Z_15</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
   <equippedAngleOffset>40</equippedAngleOffset>
	<weaponTags>
     <li>Ukraine_fusil</li>
   </weaponTags>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_ukraine</li>
	<li>PrecisionRifling</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
</ThingDef>

  <ThingDef ParentName="Geopol_sniper">
    <defName>Geopol_Snipex_Alligator</defName>
    <label>Fusil de précision Snipex Alligator</label>
    <description>Le Snipex Alligator est un fusil de précision lourd de fabrication ukrainienne. Conçu dans les années 2020, il allie puissance de feu extrême et portée exceptionnelle, capable de neutraliser des cibles protégées à longue distance.</description>
    <graphicData>
      <texPath>Weapons/Sniper/Snipex_Alligator</texPath>
