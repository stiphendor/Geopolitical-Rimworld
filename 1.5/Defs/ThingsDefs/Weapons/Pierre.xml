<Defs>

        <ThingDef ParentName="BaseWeaponNeolithic">
          <defName>Geopol_pierre</defName>
          <label>pierre</label>
          <description>Une pierre que l'on peut lancer.</description>
          <graphicData>
            <texPath>Weapons/distance/pierre</texPath>
            <graphicClass>Graphic_Single</graphicClass>
          </graphicData>
          <soundInteract>Interact_BeatFire</soundInteract>
	<costStuffCount>5</costStuffCount>
	<stuffCategories>
		<li>Stony</li>
	</stuffCategories>
          <techLevel>Neolithic</techLevel>
          <statBases>
            <WorkToMake>500</WorkToMake>
            <Mass>1</Mass>
            <AccuracyTouch>0.80</AccuracyTouch>
            <AccuracyShort>0.50</AccuracyShort>
            <AccuracyMedium>0.30</AccuracyMedium>
            <AccuracyLong>0.20</AccuracyLong>
            <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
          </statBases>
          <weaponTags>
        	<li>pierre</li>
		<li>petanque</li>
	      <li>NeolithicRangedBasic</li>
          </weaponTags>
          <verbs>
            <li>
              <verbClass>Verb_Shoot</verbClass>
              <hasStandardCommand>true</hasStandardCommand>
              <defaultProjectile>Pierre_Thrown</defaultProjectile>
              <warmupTime>1.5</warmupTime>
              <burstShotCount>1</burstShotCount>
              <range>14.9</range>
              <soundCast>Interact_BeatFire</soundCast>
            </li>
          </verbs>
          <tools>
            <li>
              <label>pierre</label>
              <capacities>
                <li>Blunt</li>
	          <li>Poke</li>
              </capacities>
              <power>7</power>
              <cooldownTime>2</cooldownTime>
            </li>
          </tools>
	<recipeMaker>
	<recipeUsers>
		<li>CraftingSpot</li>
	</recipeUsers>
	</recipeMaker>
        </ThingDef>

<ThingDef ParentName="BaseProjectileNeolithic">
  <defName>Pierre_Thrown</defName>
  <label>pierre</label>
  <graphicData>
    <texPath>Weapons/distance/pierrelance</texPath>
    <graphicClass>Graphic_Flicker</graphicClass>
  </graphicData>
  <projectile>
    <flyOverhead>false</flyOverhead>
      <damageDef>Blunt</damageDef>
    <damageAmountBase>4</damageAmountBase>
    <arcHeightFactor>1.5</arcHeightFactor>
    <stoppingPower>.5</stoppingPower>
      <speed>20</speed>
  </projectile>
</ThingDef>



