<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	

  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>Geopol_Katana</defName>
    <label>katana</label>
    <description>Le Katana (かたな en Hiragana) est un sabre japonais, la lame est courbée avec un tranchant et elle mesure plus de 60 cm. Cette arme blanche était utilisée par les samouraïs lors de l'époque Edo notamment au Japon.</description>
    <graphicData>
      <texPath>Weapons/melee/yakuza/Yakuza_Katana</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>Katana</li>
    </weaponTags>
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>2</Mass>
    </statBases>
    <relicChance>1</relicChance>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <costList>
      <Steel>80</Steel>
    </costList>
    <tools>
      <li>
        <label>poignée</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>pointe</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>25</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>lame</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>25</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>LongBlades</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>



