<?xml version="1.0" encoding="utf-8"?>
<Defs>

<ThingDef ParentName="Geopol_rifle">
   <defName>Geopol_Thales_F90c</defName>
   <label>Fusil d'assaut Thales F90</label>
   <description>Le F90 est un fusil d'assaut du fabricant australien Thales Australia, une filiale du groupe français Thales, produit en Australie à partir de 2012.</description>
   <graphicData>
     <texPath>Weapons/Rifle/Thales_F90</texPath>
     <graphicClass>Graphic_Single</graphicClass>
   </graphicData>
    <equippedAngleOffset>40</equippedAngleOffset>
   <weaponTags>
     <li>Australie_fusil</li>
   </weaponTags>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_australie</li>
	<li>PrecisionRifling</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
</ThingDef>


  <ThingDef ParentName="Geopol_sniper">
    <defName>Geopol_Blaser_LRS</defName>
    <label>Fusil de précision Blaser LRS 2</label>
    <description>Le Blaser LRS 2 est un fusil sniper allemand, utilisé par les force de police et militaire allemandes, néerlandais et australiens. Les fusils sont fabriqués par le fabricant d'armes Blaser. Les LRS 2 sont des fusils à mécanisme à verrou.</description>
    <graphicData>
      <texPath>Weapons/Sniper/Blaser_LRS_2</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	<equippedAngleOffset>40</equippedAngleOffset>
	<weaponTags>
	     <li>Australie_sniper</li>
	</weaponTags>
    <recipeMaker>
      <researchPrerequisites>
	<li>Geopol_research_allemagne</li>
	<li>PrecisionRifling</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
  
