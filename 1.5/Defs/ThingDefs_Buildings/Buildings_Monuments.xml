<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>Geopol_Eiffel</defName>
    <label>Tour Eiffel</label>
    <description>Monument en fer français de 330m de haut.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Sculptures/Eiffel</texPath>
	<drawSize>(19.2,48)</drawSize>
      <shadowData>
		<volume>(5.2, 5.1, 5.8)</volume>
      </shadowData>
    </graphicData>
    <size>(5,5)</size>
    <uiIconScale>0.8</uiIconScale>
    <uiIconOffset>(0, 0.2)</uiIconOffset>
    <costList>
      <Steel>2000</Steel>
    </costList>
    <statBases>
	<MaxHitPoints>20000</MaxHitPoints>
	<Flammability>0</Flammability>
	<Beauty>1000</Beauty>
	<WorkToBuild>60000</WorkToBuild>
    </statBases>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <altitudeLayer>Pawn</altitudeLayer>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>Geopol_research_france</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>16</constructionSkillPrerequisite>
  </ThingDef>

