<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef ParentName="MealFineBase">
    <defName>australian_meat_pie</defName>
    <label>meat pie</label>
    <description>A pie with a meat filling. A very popular recipe in Australia, the meat pie having arrived on Australian shores at the same time as the first fleet of settler boats.</description>
    <graphicData>
      <texPath>Meal/Meat Pie</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <ingestible>
      <specialThoughtDirect>WF_AteMeat_Pie</specialThoughtDirect>
    </ingestible>
    <comps>
    <li Class="CompProperties_Ingredients">
      <noIngredientsFoodKind>Meat</noIngredientsFoodKind>
    </li>
    </comps>
</ThingDef>


</Defs>