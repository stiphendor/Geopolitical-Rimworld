<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>australia</defName>
    <label>Australie</label>
    <description>L’Australie (officiellement Commonwealth d’Australie) est un pays de l’hémisphère Sud dont la superficie couvre la plus grande partie de l'Océanie. En plus de l’île-continent du même nom, le pays comprend la Tasmanie ainsi que d’autres îles des océans Austral, Pacifique et Indien.</description>
    <pawnSingular>australien</pawnSingular>
    <pawnsPlural>australiens</pawnsPlural>
    <listOrderPriority>20</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>gouverneur général</leaderTitle>
    <factionIconPath>Icon/australie</factionIconPath>
    <colorSpectrum>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
    </colorSpectrum>
    <permanentEnemy>false</permanentEnemy>
    <fixedName>Australie</fixedName>
    <settlementNameMaker>nomcolonieaustralie</settlementNameMaker>
    <allowedCultures><li>Australienne</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginChristian</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Rancher</li>
      <li MayRequire="Sarg.AlphaMemes">AM_Cowboys</li>
      <li MayRequire="VanillaExpanded.VMemesE,VanillaExpanded.VCEF">VME_Angler</li>
      <li MayRequire="MortStrudel.MortIdeology">MI_GovernmentLiberty</li>
    </requiredMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
      <li MayRequire="MortStrudel.MortIdeology">MI_LeaderAnarchy</li>
      <li MayRequire="MortStrudel.MortIdeology">MI_DrugUse_Allowed</li>
    </disallowedPrecepts>
    <techLevel>Industrial</techLevel>
    <backstoryCategories>
      <li>Australie</li>
    </backstoryCategories>
    <baseTraderKinds>
      <li>Base_australie</li>
    </baseTraderKinds>
    <caravanTraderKinds>
      <li>Caravan_australie</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_australie</li>
    </visitorTraderKinds>
    <allowedArrivalTemperatureRange>
      <min>-10</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
    <apparelStuffFilter>
      <thingDefs>
        <li>Leather_Plain</li>
	<li>Leather_Light</li>
	<li>Leather_Heavy</li>
        <li>Cloth</li>
        <li>Steel</li>
      </thingDefs>
    </apparelStuffFilter>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <australia_army_melee>3</australia_army_melee>
          <australia_army_ar>10</australia_army_ar>
          <australia_army_medecin>2</australia_army_medecin>
          <australia_army_mg>3</australia_army_mg>
          <australia_army_sniper>2</australia_army_sniper>
          <australia_chef>0.01</australia_chef>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <australia_army_trader>1</australia_army_trader>
        </traders>
        <carriers>
          <Horse>1</Horse>
        </carriers>
        <guards>
          <australia_army_melee>2</australia_army_melee>
          <australia_army_ar>8</australia_army_ar>
          <australia_army_medecin>2</australia_army_medecin>
        </guards>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <australian_civil>10</australian_civil>
          <australia_chef>1</australia_chef>
        </options>
      </li>
      <li>
        <!-- Base defense -->
        <kindDef>Settlement</kindDef>
        <options>
          <australian_civil>5</australian_civil>
          <australia_army_melee>3</australia_army_melee>
          <australia_army_ar>10</australia_army_ar>
          <australia_army_medecin>2</australia_army_medecin>
          <australia_army_mg>3</australia_army_mg>
          <australia_army_sniper>2</australia_army_sniper>
          <australia_chef>1</australia_chef>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>Icon/AustralieSettlement</settlementTexturePath>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>1</configurationListOrderPriority>
  </FactionDef>

</Defs>