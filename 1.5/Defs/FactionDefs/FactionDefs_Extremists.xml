<Defs>


  <FactionDef ParentName="FactionBase">
    <defName>Antifas</defName>
    <label>Antifascistes</label>
    <description>Situé à l'ultra gauche de l'échiquier politique, les antifascistes mettent en avant la lutte physique contre les groupuscules d'extrême droite. Opérant généralement dans l'anonymat et sans structure formelle, cette mouvance se caractérise notamment par des manifestations et des actions violentes. Son combat s'est peu à peu étendu à l'anticapitalisme, la lutte contre le racisme, l'homophobie ou les violences policières.</description>
    <pawnSingular>antifasciste</pawnSingular>
    <pawnsPlural>antifascistes</pawnsPlural>
    <listOrderPriority>10</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>leader</leaderTitle>
    <factionIconPath>Icon/antifa</factionIconPath>
    <colorSpectrum>
      <li>(255, 255, 255)</li>
    </colorSpectrum>
    <fixedName>Antifas</fixedName>
    <settlementNameMaker>nomcolonieantifa</settlementNameMaker>
    <allowedCultures><li>antifa</li></allowedCultures>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Proselytizer</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HighLife</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
