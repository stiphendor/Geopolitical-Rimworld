        <commonality>100</commonality>
        <options>
          <Redskin_melee_1>3</Redskin_melee_1>
          <Redskin_melee_2>3</Redskin_melee_2>
          <Antifa_melee_1>3</Antifa_melee_1>
          <Antifa_melee_2>3</Antifa_melee_2>
          <Antifa_melee_3>3</Antifa_melee_3>
          <Antifa_leader>1</Antifa_leader>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Redskin_melee_1>3</Redskin_melee_1>
          <Redskin_melee_2>3</Redskin_melee_2>
          <Antifa_melee_1>3</Antifa_melee_1>
          <Antifa_melee_2>3</Antifa_melee_2>
          <Antifa_melee_3>3</Antifa_melee_3>
          <Antifa_leader>1</Antifa_leader>
        </options>
      </li>
      <li>
        <!-- Base defense -->
        <kindDef>Settlement</kindDef>
        <options>
          <Redskin_melee_1>3</Redskin_melee_1>
          <Redskin_melee_2>3</Redskin_melee_2>
          <Antifa_melee_1>3</Antifa_melee_1>
          <Antifa_melee_2>3</Antifa_melee_2>
          <Antifa_melee_3>3</Antifa_melee_3>
          <Antifa_leader>1</Antifa_leader>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>Icon/AntifaSettlement</settlementTexturePath>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>4</configurationListOrderPriority>
  </FactionDef>


