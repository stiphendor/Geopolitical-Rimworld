    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
      <li MayRequire="MortStrudel.MortIdeology">MI_WealthEquality</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Egalitarian</li>
