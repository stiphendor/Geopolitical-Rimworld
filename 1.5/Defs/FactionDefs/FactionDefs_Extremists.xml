      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
      <li MayRequire="MortStrudel.MortIdeology">Slavery_Disapproved</li>
      <li MayRequire="MortStrudel.MortIdeology">Slavery_Horrible</li>
    </disallowedPrecepts>
    <techLevel>Industrial</techLevel>
    <backstoryCategories>
      <li>Antifa</li>
    </backstoryCategories>
    <allowedArrivalTemperatureRange>
      <min>-20</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <apparelStuffFilter>
      <thingDefs>
