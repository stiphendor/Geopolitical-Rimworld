<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>femen</defName>
    <label>Femen</label>
    <description>Les Femen sont un mouvement féministe créé en Ukraine. Les militantes de cette organisation défendent les droits des femmes et sont connues pour la provocation de leurs actions, souvent seins nus. Les militantes de Femen sont adeptes d'un féminisme radical qu'elles appellent « sextrémisme ». Le mouvement Femen s'affirme athée et antireligieux.</description>
    <pawnSingular>femen</pawnSingular>
    <pawnsPlural>femen</pawnsPlural>
    <listOrderPriority>10</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>false</canSiege>
    <canStageAttacks>false</canStageAttacks>
    <leaderTitle>porte-parole</leaderTitle>
    <factionIconPath>Icon/Femen</factionIconPath>
    <colorSpectrum>
      <li>(255, 255, 255)</li>
    </colorSpectrum>
    <fixedName>Femen</fixedName>
    <settlementNameMaker>nomcoloniefemen</settlementNameMaker>
    <allowedCultures><li>femen</li></allowedCultures>
    <structureMemeWeights>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
    </structureMemeWeights>
    <requiredMemes>
      <li MayRequire="Sarg.AlphaMemes">AM_Structure_Atheist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FemaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Emancipation</li>
    </requiredMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
    </disallowedPrecepts>
    <techLevel>Industrial</techLevel>
    <backstoryCategories>
      <li>Femen</li>
    </backstoryCategories>
    <allowedArrivalTemperatureRange>
      <min>0</min>
      <max>65</max>
    </allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
	  <Femen1>1</Femen1>
	  <Femenleader1>1</Femenleader1>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
	  <Femen1>1</Femen1>
	  <Femenleader1>1</Femenleader1>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
	  <Femen1>1</Femen1>
	  <Femenleader1>1</Femenleader1>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>Icon/FemenSettlement</settlementTexturePath>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>4</configurationListOrderPriority>
  </FactionDef>

</Defs>