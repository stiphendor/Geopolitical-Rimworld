<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>suisse</defName>
    <label>Suisse</label>
    <description>La Suisse est un pays d'Europe centrale connu pour sa neutralité géopolitique et ses banques, ses habitants sont parmis les plus riches du monde.</description>
    <pawnSingular>suisse</pawnSingular>
    <pawnsPlural>suisses</pawnsPlural>
    <listOrderPriority>20</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>président de la confédération</leaderTitle>
    <factionIconPath>Icon/suisse</factionIconPath>
    <colorSpectrum>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
    </colorSpectrum>
    <permanentEnemy>false</permanentEnemy>
    <fixedName>Suisse</fixedName>
    <settlementNameMaker>nomcolonie_suisse</settlementNameMaker>
    <allowedCultures><li>Suisse</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginChristian</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Republic</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Trader</li>
    </requiredMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
    </disallowedPrecepts>
    <techLevel>Industrial</techLevel>
    <backstoryCategories>
      <li>Suisse</li>
    </backstoryCategories>
    <baseTraderKinds>
      <li>Base_suisse</li>
    </baseTraderKinds>
    <caravanTraderKinds>
      <li>Caravan_suisse</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_suisse</li>
    </visitorTraderKinds>
    <allowedArrivalTemperatureRange>
      <min>-40</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
    <apparelStuffFilter>
      <thingDefs>
        <li>Leather_Plain</li>
	<li>Leather_Light</li>
	<li>Leather_Heavy</li>
        <li>Cloth</li>
        <li>Steel</li>
      </thingDefs>
    </apparelStuffFilter>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <suisse_army_melee>3</suisse_army_melee>
          <suisse_army_ar>10</suisse_army_ar>
          <suisse_army_medecin>2</suisse_army_medecin>
          <suisse_army_mg>3</suisse_army_mg>
          <suisse_army_sniper>2</suisse_army_sniper>
          <suisse_chef>0.01</suisse_chef>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <suisse_army_trader>1</suisse_army_trader>
        </traders>
        <carriers>
          <Horse>1</Horse>
        </carriers>
        <guards>
          <suisse_army_melee>2</suisse_army_melee>
          <suisse_army_ar>8</suisse_army_ar>
          <suisse_army_medecin>2</suisse_army_medecin>
        </guards>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <suisse_army_melee>2</suisse_army_melee>
          <suisse_army_ar>8</suisse_army_ar>
          <suisse_army_medecin>2</suisse_army_medecin>
          <suisse_chef>1</suisse_chef>
        </options>
      </li>
      <li>
        <!-- Base defense -->
        <kindDef>Settlement</kindDef>
        <options>
          <suisse_army_melee>3</suisse_army_melee>
          <suisse_army_ar>10</suisse_army_ar>
          <suisse_army_medecin>2</suisse_army_medecin>
          <suisse_army_mg>3</suisse_army_mg>
          <suisse_army_sniper>2</suisse_army_sniper>
          <suisse_chef>1</suisse_chef>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>Icon/SuisseSettlement</settlementTexturePath>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>1</configurationListOrderPriority>
  </FactionDef>

</Defs>