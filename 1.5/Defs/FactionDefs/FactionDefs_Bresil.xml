<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>bresil</defName>
    <label>Brésil</label>
    <description>Le Brésil, vaste pays d'Amérique du Sud, s'étend du bassin amazonien au nord à des vignobles et aux chutes d'Iguaçu au sud. La ville de Rio de Janeiro, caractérisée par sa statue du Christ Rédempteur de 38 mètres de haut située au sommet du Corcovado, est réputée pour ses plages très fréquentées de Copacabana et d'Ipanema, ainsi que pour son énorme carnaval animé, avec défilés de chars, costumes flamboyants, et musique et danse samba.</description>
    <pawnSingular>brazilian</pawnSingular>
    <pawnsPlural>brésiliens</pawnsPlural>
    <listOrderPriority>20</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>président</leaderTitle>
    <factionIconPath>Icon/bresil</factionIconPath>
    <colorSpectrum>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
    </colorSpectrum>
    <permanentEnemy>false</permanentEnemy>
    <fixedName>Brésil</fixedName>
    <settlementNameMaker>nomcolonieBresil</settlementNameMaker>
    <allowedCultures><li>Bresilienne</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginChristian</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Christianisme</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_PartyLife</li>
    </requiredMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
    </disallowedPrecepts>
    <techLevel>Industrial</techLevel>
    <backstoryCategories>
      <li>Bresil</li>
    </backstoryCategories>
    <baseTraderKinds>
      <li>Base_bresil</li>
    </baseTraderKinds>
    <caravanTraderKinds>
      <li>Caravan_bresil</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_bresil</li>
    </visitorTraderKinds>
    <allowedArrivalTemperatureRange>
      <min>-10</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <brazil_army_melee>3</brazil_army_melee>
          <brazil_army_ar>10</brazil_army_ar>
          <brazil_army_medecin>2</brazil_army_medecin>
          <brazil_army_mg>3</brazil_army_mg>
          <brazil_army_sniper>2</brazil_army_sniper>
          <brazil_chef>0.01</brazil_chef>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
