          <brazil_army_trader>1</brazil_army_trader>
        </traders>
        <carriers>
          <Horse>1</Horse>
        </carriers>
        <guards>
          <brazil_army_melee>2</brazil_army_melee>
          <brazil_army_ar>8</brazil_army_ar>
          <brazil_army_medecin>2</brazil_army_medecin>
        </guards>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
