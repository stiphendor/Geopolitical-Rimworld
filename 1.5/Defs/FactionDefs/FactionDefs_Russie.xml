<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>russie</defName>
    <label>Russie</label>
    <description>La fédération de Russie est le plus vaste pays du monde, qui a pour particularité de s'étendre sur deux continents, l'Europe pour un peu moins du quart (où se trouve sa capitale Moscou) et l'Asie pour un peu plus des trois-quarts restants. Cependant, il est traditionnellement considéré que la Russie est un pays européen (une majorité soit 78 % de sa population vit dans la partie européenne).</description>
    <pawnSingular>russe</pawnSingular>
    <pawnsPlural>russes</pawnsPlural>
    <listOrderPriority>20</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>président</leaderTitle>
    <factionIconPath>Icon/russia</factionIconPath>
    <colorSpectrum>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
    </colorSpectrum>
    <permanentEnemy>false</permanentEnemy>
    <fixedName>Russie</fixedName>
    <settlementNameMaker>nomcolonieru</settlementNameMaker>
    <allowedCultures><li>Russe</li></allowedCultures>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
