<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>ukraine</defName>
    <label>Ukraine</label>
    <description>L'ukraine est un pays d'Europe de l'Est devenu indépendant suite à la dislocation de l'union soviétique.</description>
    <pawnSingular>ukrainien</pawnSingular>
    <pawnsPlural>ukrainiens</pawnsPlural>
    <listOrderPriority>20</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>président</leaderTitle>
    <factionIconPath>Icon/ukraine</factionIconPath>
    <colorSpectrum>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
      <li>(255, 255, 255)</li>
    </colorSpectrum>
    <permanentEnemy>false</permanentEnemy>
    <fixedName>Ukraine</fixedName>
    <settlementNameMaker>nomcolonieukraine</settlementNameMaker>
    <allowedCultures><li>Ukrainienne</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginChristian</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_Nationalist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Christianisme</li>
    </requiredMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
    </disallowedPrecepts>
    <techLevel>Industrial</techLevel>
    <backstoryCategories>
      <li>Ukraine</li>
    </backstoryCategories>
    <caravanTraderKinds>
      <li>Caravan_ukraine</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_ukraine</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_ukraine</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>
      <min>-40</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
    <apparelStuffFilter>
      <thingDefs>
        <li>Leather_Plain</li>
	<li>Leather_Light</li>
	<li>Leather_Heavy</li>
        <li>Cloth</li>
        <li>Steel</li>
      </thingDefs>
    </apparelStuffFilter>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <ukraine_army_melee>3</ukraine_army_melee>
          <ukraine_army_ar>10</ukraine_army_ar>
          <ukraine_army_medecin>2</ukraine_army_medecin>
          <ukraine_army_mg>3</ukraine_army_mg>
          <ukraine_army_sniper>2</ukraine_army_sniper>
          <ukraine_chef>0.01</ukraine_chef>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <ukraine_army_trader>1</ukraine_army_trader>
        </traders>
        <carriers>
          <Horse>1</Horse>
        </carriers>
        <guards>
          <ukraine_army_melee>2</ukraine_army_melee>
          <ukraine_army_ar>8</ukraine_army_ar>
          <ukraine_army_medecin>2</ukraine_army_medecin>
          <ukraine_army_mg>2</ukraine_army_mg>
        </guards>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <ukraine_army_melee>2</ukraine_army_melee>
          <ukraine_army_ar>8</ukraine_army_ar>
          <ukraine_army_medecin>2</ukraine_army_medecin>
          <ukraine_chef>1</ukraine_chef>
        </options>
      </li>
      <li>
        <!-- Base defense -->
        <kindDef>Settlement</kindDef>
        <options>
          <ukraine_army_melee>3</ukraine_army_melee>
          <ukraine_army_ar>10</ukraine_army_ar>
          <ukraine_army_medecin>2</ukraine_army_medecin>
          <ukraine_army_mg>3</ukraine_army_mg>
          <ukraine_army_sniper>2</ukraine_army_sniper>
          <ukraine_chef>1</ukraine_chef>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>Icon/UkraineSettlement</settlementTexturePath>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>1</configurationListOrderPriority>
  </FactionDef>

</Defs>