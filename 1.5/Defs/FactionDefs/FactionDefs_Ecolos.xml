    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_ecolo_radical</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_ecolo_radical</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>
      <min>-20</min>
      <max>45</max>
    </allowedArrivalTemperatureRange>
    <apparelStuffFilter>
      <thingDefs>
        <li>Cloth</li>
