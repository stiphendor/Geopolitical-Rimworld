<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>Chretienne</defName>
    <label>Chrétienne</label>
    <description>Culture Chrétienne.</description>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoChretien</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityChristian</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DietyTypeMakerAbrahamic</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_Chre</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalChre</festivalNameMaker>
    <pawnNameMaker>nom_chretien_h</pawnNameMaker>
    <pawnNameMakerFemale>nom_chretien_f</pawnNameMakerFemale>
    <iconPath>Symbols/chretiens/cross</iconPath>
    <allowedPlaceTags>
      <li>OriginChretiens</li>
    </allowedPlaceTags>
    <styleItemTags>
      <li>
        <tag>chretien_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>5</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>


  <RulePackDef>
    <defName>nom_chretien_h</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prefixhchre] [prenomhchre]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prefixhchre</keyword>
          <path>Noms/prefix_h_chre</path>
        </li>
        <li Class="Rule_File">
          <keyword>prenomhchre</keyword>
          <path>Noms/prenom_m_chre</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>


  <RulePackDef>
    <defName>nom_chretien_f</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prefixfchre] [prenomfchre]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prefixfchre</keyword>
          <path>Noms/prefix_f_chre</path>
        </li>
        <li Class="Rule_File">
          <keyword>prenomfchre</keyword>
          <path>Noms/prenom_f_chre</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>nomcoloniechre</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[colonie_chre]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>colonie_chre</keyword>
          <path>Noms/colonie_chre</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerIdeoChretien</defName>
    <rulePack>
      <rulesStrings>
	<li>r_ideoName->Christianisme</li>
        <li>r_ideoAdjective->chrétien</li>
        <li>r_memberName->Chrétien</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_Chre</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Pape</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <PlaceDef>
    <defName>Chretiens</defName>
    <tags>
      <li>OriginChretiens</li>
    </tags>
    <placeRules>
      <include>
        <li>PlaceMakerCommon</li>
      </include>
      <rulesStrings>
        <li>place_name->Vatican</li>
        <li>place_adjective->cité</li>
        <li>place_summary->ville sainte</li>
        <li>place_community->colline du Vatican</li>
        <li>place_community->Résidence Sainte-Marthe</li>
        <li>place_community->Scala Santa</li>
        <li>place_powerCenter->Palais apostolique</li>
        <li>place_job->charpentier</li>
        <li>place_personalWeapon->foi</li>
        <li>place_personalWeapon->prières</li>
        <li>place_massWeapon->tentation</li>
        <li>place_foeLeader->Diable</li>
        <li>place_foeSoldiers->démons</li>
      </rulesStrings>
    </placeRules>
  </PlaceDef>

  <RulePackDef>
    <defName>NamerFestivalChre</defName>
    <rulePack>
      <rulesStrings>
        <li>festivalName->Epiphanie</li>
        <li>festivalName->Chandeleur</li>
        <li>festivalName->Annonciation</li>
        <li>festivalName->Carême</li>
        <li>festivalName->Pâques</li>
        <li>festivalName->Ascension</li>
        <li>festivalName->Pentecôte</li>
        <li>festivalName->Assomption</li>
        <li>festivalName->Toussaint</li>
        <li>festivalName->Noël</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

</Defs>
