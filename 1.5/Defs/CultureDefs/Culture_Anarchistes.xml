  <RulePackDef>
    <defName>NamerIdeoAnarchisme</defName>
    <rulePack>
      <rulesStrings>
        <li>r_ideoName->Anarchisme</li>
        <li>r_ideoAdjective->anarchiste</li>
        <li>r_memberName->Anarchiste</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_Anarchiste</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Anarchiste</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <PlaceDef>
    <defName>Anarchiste</defName>
    <tags>
      <li>OriginAnarchiste</li>
    </tags>
    <placeRules>
      <include>
        <li>PlaceMakerCommon</li>
      </include>
      <rulesStrings>
        <li>place_name->Ménilmontant</li>
        <li>place_adjective->populaire</li>
        <li>place_summary->quartier populaire</li>
        <li>place_community->bar</li>
        <li>place_community->local occupé</li>
        <li>place_powerCenter->squat</li>
        <li>place_job->sans emploi</li>
        <li>place_personalWeapon->couteau</li>
        <li>place_personalWeapon->matraque</li>
        <li>place_massWeapon->lynchage</li>
        <li>place_foeLeader->homme politique</li>
        <li>place_foeSoldiers->policiers</li>
      </rulesStrings>
    </placeRules>
  </PlaceDef>

  <RulePackDef>
    <defName>NamerFestivalanarchiste</defName>
    <rulePack>
      <rulesStrings>
        <li>festivalName->Autoréduction</li>
        <li>festivalName->Rassemblement anticapitaliste</li>
        <li>festivalName->Rassemblement contre les violences d'état</li>
        <li>festivalName->Rassemblement contre le gouvernement</li>
        <li>festivalName->Rassemblement pour l'autonomie des peuples</li>
        <li>festivalName->Assemblée générale contre les expulsions</li>
        <li>festivalName->Réunion en mixité choisie</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

