<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>anarchiste</defName>
    <label>Anarchiste</label>
    <description>Culture anarchiste.</description>
    <pawnNameMaker>nom_int_h</pawnNameMaker>
    <pawnNameMakerFemale>nom_int_f</pawnNameMakerFemale>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoAnarchisme</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityChristian</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DietyTypeMakerAbrahamic</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_Anarchiste</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalanarchiste</festivalNameMaker>
    <iconPath>Symbols/anarchie/anarchy</iconPath>
    <allowedPlaceTags>
    <li>OriginAnarchiste</li>
    </allowedPlaceTags>
    <styleItemTags>
      <li>
        <tag>Anarchiste_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>Ecolo_beard</tag>
        <baseWeight>10</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>

  <RulePackDef>
    <defName>nom_int_h</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenomhuk] [nomuk]</li>
	<li>name-&gt;[prenomhfra] [nomfra]</li>
        <li>name-&gt;[prenom_m_italien] [nom_italien]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenomhuk</keyword>
          <path>Noms/prenom_m_uk</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomuk</keyword>
          <path>Noms/nom_uk</path>
        </li>
        <li Class="Rule_File">
          <keyword>prenomhfra</keyword>
          <path>Noms/prenom_m_fra</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomfra</keyword>
          <path>Noms/nom_fra</path>
        </li>
        <li Class="Rule_File">
          <keyword>prenom_m_italien</keyword>
          <path>Noms/prenom_m_italien</path>
        </li>
        <li Class="Rule_File">
          <keyword>nom_italien</keyword>
          <path>Noms/nom_italien</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
