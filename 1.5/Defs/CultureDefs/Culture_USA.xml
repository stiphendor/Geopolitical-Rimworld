<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>Americaine</defName>
    <label>Américaine</label>
    <description>Culture américaine.</description>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoUSA</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityChristian</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DietyTypeMakerAbrahamic</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_USA</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalUSA</festivalNameMaker>
    <pawnNameMaker>nom_usa_h</pawnNameMaker>
    <pawnNameMakerFemale>nom_usa_f</pawnNameMakerFemale>
    <iconPath>Symbols/usa/flag</iconPath>
    <allowedPlaceTags>
      <li>OriginUSA</li>
    </allowedPlaceTags>
    <styleItemTags>
      <li>
        <tag>Soldat_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>5</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>Soldat_beard</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>

  <RulePackDef>
    <defName>nom_usa_h</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenommusa] [nomusa]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenommusa</keyword>
          <path>Noms/prenom_m_americain</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomusa</keyword>
          <path>Noms/nom_americain</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>


  <RulePackDef>
    <defName>nom_usa_f</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenomfusa] [nomusa]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenomfusa</keyword>
          <path>Noms/prenom_f_americain</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomusa</keyword>
          <path>Noms/nom_americain</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>nomcolonieetats_unis</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[colonie_usa]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>colonie_usa</keyword>
          <path>Noms/colonie_usa</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerIdeoUSA</defName>
    <rulePack>
      <rulesStrings>
	<li>r_ideoName->Idéologie américaine</li>
        <li>r_ideoAdjective->Américain</li>
        <li>r_memberName->Américain</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_USA</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Président</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <PlaceDef>
    <defName>USA</defName>
    <tags>
      <li>OriginUSA</li>
    </tags>
    <placeRules>
      <include>
        <li>PlaceMakerCommon</li>
      </include>
      <rulesStrings>
        <li>place_name->Washington D.C</li>
        <li>place_adjective->washingtonien</li>
        <li>place_summary->capitale</li>
        <li>place_community->diner</li>
        <li>place_community->George Town</li>
        <li>place_community->Capitole</li>
        <li>place_community->Lincoln Memorial</li>
        <li>place_powerCenter->Maison Blanche</li>
        <li>place_job->catcheur</li>
        <li>place_job->garagiste</li>
        <li>place_job->joueur de football</li>
        <li>place_personalWeapon->fusils</li>
        <li>place_personalWeapon->matraques</li>
        <li>place_massWeapon->arme nucléaire</li>
        <li>place_foeLeader->Vladimir Poutine</li>
        <li>place_foeSoldiers->soldats russes</li>
      </rulesStrings>
    </placeRules>
  </PlaceDef>

  <RulePackDef>
    <defName>NamerFestivalUSA</defName>
    <rulePack>
      <rulesStrings>
        <li>festivalName->Mardi Gras</li>
        <li>festivalName->Vendredi Saint</li>
        <li>festivalName->Journéee des patriotes</li>
        <li>festivalName->Jour du souvenir</li>
        <li>festivalName->Halloween</li>
        <li>festivalName->Thanksgiving</li>
        <li>festivalName->Réveillon</li>
        <li>festivalName->Saint-sylvestre</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
</Defs>
