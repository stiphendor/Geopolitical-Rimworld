<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>Ukrainienne</defName>
    <label>Ukrainienne</label>
    <description>Culture Ukrainienne.</description>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoUkraine</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityAstropolitan</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DeityTypeMakerAstropolitan</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_Ukraine</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalUkraine</festivalNameMaker>
    <pawnNameMaker>nom_ukrainien_h</pawnNameMaker>
    <pawnNameMakerFemale>nom_ukrainien_f</pawnNameMakerFemale>
    <iconPath>Symbols/ukraine/ukraine</iconPath>
    <allowedPlaceTags>
      <li>OriginUkraine</li>
    </allowedPlaceTags>
    <styleItemTags>
      <li>
        <tag>Soldat_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>



  <RulePackDef>
    <defName>nom_ukrainien_f</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenom_f_ukr] [nom_ukr]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenom_f_ukr</keyword>
          <path>Noms/prenom_f_ukr</path>
        </li>
        <li Class="Rule_File">
          <keyword>nom_ukr</keyword>
          <path>Noms/nom_ukr</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>nom_ukrainien_h</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenom_h_ukr] [nom_ukr]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenom_h_ukr</keyword>
          <path>Noms/prenom_m_ukr</path>
        </li>
        <li Class="Rule_File">
          <keyword>nom_ukr</keyword>
          <path>Noms/nom_ukr</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerIdeoUkraine</defName>
    <rulePack>
      <rulesStrings>
	<li>r_ideoName->Idéologie ukrainienne</li>
        <li>r_ideoAdjective->Ukrainien</li>
        <li>r_memberName->Ukrainien</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>nomcolonieukraine</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[colonie_ukraine]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>colonie_ukraine</keyword>
          <path>Noms/colonie_ukraine</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_Ukraine</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Président</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <PlaceDef>
    <defName>Ukraine</defName>
    <tags>
      <li>OriginUkraine</li>
    </tags>
    <placeRules>
      <include>
        <li>PlaceMakerCommon</li>
      </include>
      <rulesStrings>
        <li>place_name->Kiev</li>
        <li>place_adjective->ukrainien</li>
        <li>place_summary->capitale</li>
        <li>place_community->Cathédrale Saint-Nicolas de Kiev</li>
        <li>place_community->Tour de télévision de Kiev</li>
        <li>place_community->Cathédrale Sainte-Sophie de Kiev</li>
        <li>place_powerCenter->Palais Mariinsky</li>
        <li>place_job->acteur</li>
        <li>place_personalWeapon->fusils</li>
        <li>place_personalWeapon->matraques</li>
        <li>place_massWeapon->arme nucléaire</li>
        <li>place_foeLeader->Vladimir Poutine</li>
        <li>place_foeSoldiers->soldats russes</li>
      </rulesStrings>
    </placeRules>
  </PlaceDef>

  <RulePackDef>
    <defName>NamerFestivalUkraine</defName>
    <rulePack>
      <rulesStrings>
        <li>festivalName->Noël orthodoxe</li>
        <li>festivalName->Carnaval humorina</li>
        <li>festivalName->Pâque orthodoxe</li>
        <li>festivalName->Fête de Lviv</li>
        <li>festivalName->Jour de la constitution de l'Ukraine</li>
        <li>festivalName->Nouvel an</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>


</Defs>
