<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>Nord-Coreenne</defName>
    <label>Nord-Coréenne</label>
    <description>Culture nord-coréenne.</description>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoNko</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityChristian</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DietyTypeMakerAbrahamic</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_NorthKorea</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalNko</festivalNameMaker>
    <pawnNameMaker>nom_coree_du_nord_h</pawnNameMaker>
    <pawnNameMakerFemale>nom_coree_du_nord_f</pawnNameMakerFemale>
    <iconPath>Symbols/coree du nord/north-korea</iconPath>
    <allowedPlaceTags>
      <li>OriginNorthKorea</li>
    </allowedPlaceTags>
    <styleItemTags>
      <li>
        <tag>Soldat_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>5</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>

  <RulePackDef>
    <defName>nom_coree_du_nord_h</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[nom_ko2] [prenom_m_coree_du_nord]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenom_m_coree_du_nord</keyword>
          <path>Noms/prenom_m_coree_du_nord</path>
        </li>
        <li Class="Rule_File">
          <keyword>nom_ko2</keyword>
          <path>Noms/nom_ko2</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>


  <RulePackDef>
    <defName>nom_coree_du_nord_f</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[nom_ko2] [prenom_f_coree_du_nord]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenom_f_coree_du_nord</keyword>
          <path>Noms/prenom_f_coree_du_nord</path>
        </li>
        <li Class="Rule_File">
          <keyword>nom_ko2</keyword>
          <path>Noms/nom_ko2</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>nomcolonie_coree_du_nord</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[colonie_coree_du_nord]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>colonie_coree_du_nord</keyword>
          <path>Noms/colonie_coree_du_nord</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerIdeoNko</defName>
    <rulePack>
      <rulesStrings>
	<li>r_ideoName->Idéologie nord-coréenne</li>
        <li>r_ideoAdjective->Nord-Coréen</li>
        <li>r_memberName->Nord-Coréen</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_NorthKorea</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Dirigeant Suprême</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <PlaceDef>
    <defName>Coree_du_nord</defName>
    <tags>
      <li>OriginNorthKorea</li>
    </tags>
    <placeRules>
      <include>
        <li>PlaceMakerCommon</li>
      </include>
      <rulesStrings>
        <li>place_name->Pyongyang</li>
        <li>place_adjective->magnifique</li>
        <li>place_summary->capitale</li>
        <li>place_community->tour du Juche</li>
        <li>place_community->Palais du Soleil Kumsusan</li>
        <li>place_community->Arc de triomphe de Kim Il-sung</li>
        <li>place_community->Arche de la Réunification</li>
        <li>place_powerCenter->Résidence Ryongsong</li>
        <li>place_job->communiste</li>
        <li>place_personalWeapon->fusils</li>
        <li>place_personalWeapon->matraques</li>
        <li>place_massWeapon->arme nucléaire</li>
        <li>place_foeLeader->Syngman Rhee</li>
        <li>place_foeSoldiers->sud-coréens</li>
      </rulesStrings>
    </placeRules>
  </PlaceDef>

  <RulePackDef>
    <defName>NamerFestivalNko</defName>
    <rulePack>
      <rulesStrings>
        <li>festivalName->Nouvel an</li>
	<li>festivalName->Anniversaire de Kim Jong-un</li>
        <li>festivalName->Anniversaire de Kim Jong-il</li>
        <li>festivalName->Anniversaire de Kim Il-sung</li>
        <li>festivalName->Jour des Forces armées</li>
        <li>festivalName->Mort de Kim Il-sung</li>
        <li>festivalName->Victoire de la guerre de libération de la patrie</li>
        <li>festivalName->Fête de la fondation du Parti des travailleurs coréens</li>
        <li>festivalName->Fête de la Constitution</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
</Defs>
