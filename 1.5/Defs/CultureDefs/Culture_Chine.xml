<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>Chinoise</defName>
    <label>Chinoise</label>
    <description>Culture chinoise.</description>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoChine</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityAstropolitan</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DeityTypeMakerAstropolitan</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_chi</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalchi</festivalNameMaker>
    <pawnNameMaker>nom_chine_h</pawnNameMaker>
    <pawnNameMakerFemale>nom_chine_f</pawnNameMakerFemale>
    <iconPath>Symbols/chine/china</iconPath>
    <allowedPlaceTags>
      <li>OriginChine</li>
    </allowedPlaceTags>
    <styleItemTags>
      <li>
        <tag>Soldat_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>5</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>


  <RulePackDef>
    <defName>nom_chine_h</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenomhchi] [nomchi]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenomhchi</keyword>
          <path>Noms/prenom_m_chi</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomchi</keyword>
          <path>Noms/nom_chi</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>


  <RulePackDef>
    <defName>nom_chine_f</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenomfchi] [nomchi]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenomfchi</keyword>
          <path>Noms/prenom_f_chi</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomchi</keyword>
          <path>Noms/nom_chi</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>nomcoloniechi</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[colonie_chi]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>colonie_chi</keyword>
          <path>Noms/colonie_chi</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerIdeoChine</defName>
    <rulePack>
      <rulesStrings>
        <li>r_ideoName->Idéologie Chinoise</li>
        <li>r_ideoAdjective->chinois</li>
        <li>r_memberName->Chinois</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <PlaceDef>
    <defName>Chine</defName>
    <tags>
      <li>OriginChine</li>
    </tags>
    <placeRules>
      <include>
        <li>PlaceMakerCommon</li>
      </include>
      <rulesStrings>
        <li>place_name->Pékin</li>
        <li>place_adjective->pékinois</li>
        <li>place_summary->capitale</li>
        <li>place_community->Mausolée de Mao Zedong</li>
        <li>place_community->place Tian'anment</li>
        <li>place_community->Temple de Confucius</li>
        <li>place_powerCenter->Cité interdite</li>
        <li>place_job->tisseur</li>
        <li>place_job->masseur</li>
        <li>place_job->membre du parti communiste</li>
        <li>place_personalWeapon->fusils</li>
        <li>place_personalWeapon->matraques</li>
        <li>place_massWeapon->arme nucléaire</li>
        <li>place_foeLeader->américain</li>
        <li>place_foeSoldiers->américains</li>
      </rulesStrings>
    </placeRules>
  </PlaceDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_chi</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Président</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerFestivalchi</defName>
    <rulePack>
      <rulesStrings>
        <li>festivalName->Fête de la mi-automne</li>
        <li>festivalName->Fête Nationale</li>
        <li>festivalName->Fête des travailleurs</li>
        <li>festivalName->Fête de la Lune</li>
        <li>festivalName->Fête des bateaux-Dragons</li>
        <li>festivalName->Qing Ming</li>
        <li>festivalName->Fête des lanternes</li>
        <li>festivalName->Nouvel An Chinois</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>



</Defs>
