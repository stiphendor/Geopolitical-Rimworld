<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>islamisme_radical</defName>
    <label>Islamisme radical</label>
    <description>Culture islamique radicale.</description>
    <pawnNameMaker>nom_terrorist_islamist</pawnNameMaker>
    <pawnNameMakerFemale>nom_musulman_f</pawnNameMakerFemale>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoIslamiste</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityIslam</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DietyTypeMakerAbrahamic</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_Islamiste</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalIslamic</festivalNameMaker>
    <iconPath>Symbols/musulmans/musulmans</iconPath>
    <allowedPlaceTags>
      <li>OriginMusulmans</li>
    </allowedPlaceTags>
    <thingStyleCategories>
      <li>
        <category>Islamic</category>
        <priority>4</priority>
      </li>
    </thingStyleCategories>
    <styleItemTags>
      <li>
        <tag>Musulmans_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>Musulmans_beard</tag>
        <baseWeight>5</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>


  <RulePackDef>
    <defName>nom_terrorist_islamist</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[nom_terroriste_prefix] [nom_terroriste_titre]</li>
        <li>name-&gt;[prenom_h_musulman] [nom_musulman]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>nom_terroriste_prefix</keyword>
          <path>Noms/nom_terroriste_prefix</path>
        </li>
        <li Class="Rule_File">
          <keyword>nom_terroriste_titre</keyword>
          <path>Noms/nom_terroriste_titre</path>
        </li>
        <li Class="Rule_File">
          <keyword>prenom_h_musulman</keyword>
          <path>Noms/prenom_h_musulman</path>
        </li>
        <li Class="Rule_File">
          <keyword>nom_musulman</keyword>
          <path>Noms/nom_musulman</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>



  <RulePackDef>
    <defName>colonie_terroristes_islamistes</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[colonie_terroriste_islamiste_prefix] [colonie_terroriste_islamiste_nom]</li>
        <li>name-&gt;[colonie_terroriste_islamiste_prefix2] [colonie_terroriste_islamiste_nom2]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>colonie_terroriste_islamiste_prefix</keyword>
          <path>Noms/colonie_terroriste_islamiste_prefix</path>
        </li>
        <li Class="Rule_File">
          <keyword>colonie_terroriste_islamiste_nom</keyword>
          <path>Noms/colonie_terroriste_islamiste_nom</path>
        </li>
        <li Class="Rule_File">
          <keyword>colonie_terroriste_islamiste_prefix2</keyword>
          <path>Noms/colonie_terroriste_islamiste_prefix2</path>
        </li>
        <li Class="Rule_File">
          <keyword>colonie_terroriste_islamiste_nom2</keyword>
          <path>Noms/colonie_terroriste_islamiste_nom2</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>


  <RulePackDef>
    <defName>faction_terroristes_islamistes</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[faction_terroriste_islamiste_nom]</li>
        <li>name-&gt;[faction_terroriste_islamiste_nom2]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>faction_terroriste_islamiste_nom</keyword>
          <path>Noms/faction_terroriste_islamiste_nom</path>
        </li>
        <li Class="Rule_File">
          <keyword>faction_terroriste_islamiste_nom2</keyword>
          <path>Noms/faction_terroriste_islamiste_nom2</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>


  <RulePackDef>
    <defName>NamerIdeoIslamiste</defName>
    <rulePack>
      <rulesStrings>
        <li>r_ideoName->Islamisme radical</li>
        <li>r_ideoAdjective->Islamique</li>
        <li>r_memberName->Islamiste</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_Islamiste</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Calife</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>


</Defs>
