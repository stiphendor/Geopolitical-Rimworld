<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>Israelienne</defName>
    <label>Israëlienne</label>
    <description>Culture Israëlienne.</description>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoIsrael</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityJudaism</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DietyTypeMakerAbrahamic</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_Isr</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalIsr</festivalNameMaker>
    <pawnNameMaker>nom_israel_h</pawnNameMaker>
    <pawnNameMakerFemale>nom_israel_f</pawnNameMakerFemale>
    <iconPath>Symbols/israel/israel</iconPath>
    <allowedPlaceTags>
      <li>OriginIsrael</li>
    </allowedPlaceTags>
    <styleItemTags>
      <li>
        <tag>israel_hair</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>5</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>


  <RulePackDef>
    <defName>nom_israel_h</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenomhisr] [nomisr]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenomhisr</keyword>
          <path>Noms/prenom_m_isr</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomisr</keyword>
          <path>Noms/nom_isr</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>


  <RulePackDef>
    <defName>nom_israel_f</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[prenomfisr] [nomisr]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>prenomfisr</keyword>
          <path>Noms/prenom_f_isr</path>
        </li>
        <li Class="Rule_File">
          <keyword>nomisr</keyword>
          <path>Noms/nom_isr</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>nomcolonieisr</defName>
    <rulePack>
      <rulesStrings>
        <li>name-&gt;[colonie_isr]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>colonie_isr</keyword>
          <path>Noms/colonie_isr</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerIdeoIsrael</defName>
    <rulePack>
      <rulesStrings>
	<li>r_ideoName->Idéologie israëlienne</li>
        <li>r_ideoAdjective->Israëlique</li>
        <li>r_memberName->Israëlien</li>
	<li>hyphenPrefix->[memeHyphenPrefix]</li>
	<li>hyphenPrefix-> </li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerDeityJudaism</defName>
    <include>
      <li>GlobalUtility</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_deityName(p=3)->Yahvé</li>
        <li>r_deityName->YHWH</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>LeaderTitleMaker_Isr</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->Président</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <PlaceDef>
    <defName>Israel</defName>
    <tags>
      <li>OriginIsrael</li>
    </tags>
    <placeRules>
      <include>
        <li>PlaceMakerCommon</li>
      </include>
      <rulesStrings>
        <li>place_name->Jérusalem</li>
        <li>place_adjective->saint</li>
        <li>place_summary->ville sainte</li>
        <li>place_community->Mont des Oliviers</li>
        <li>place_community->synagogue</li>
        <li>place_powerCenter->Mur des Lamentations</li>
        <li>place_job->sioniste</li>
        <li>place_personalWeapon->fusils</li>
        <li>place_personalWeapon->matraques</li>
        <li>place_massWeapon->arme nucléaire</li>
        <li>place_foeLeader->Mahmoud Abbas</li>
        <li>place_foeSoldiers->palestiniens</li>
      </rulesStrings>
    </placeRules>
  </PlaceDef>

  <RulePackDef>
    <defName>NamerFestivalIsr</defName>
    <rulePack>
      <rulesStrings>
        <li>festivalName->Roch Hachana</li>
        <li>festivalName->Yom Kippour</li>
        <li>festivalName->Souccot</li>
        <li>festivalName->Sim’hat Torah</li>
        <li>festivalName->Hanouka</li>
        <li>festivalName->Tou Bichvat</li>
        <li>festivalName->Pourim</li>
        <li>festivalName->Pessa’h</li>
        <li>festivalName->Chavouot</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

</Defs>
