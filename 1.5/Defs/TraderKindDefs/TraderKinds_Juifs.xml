<!-- Buildings -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Geopol_book_juif</thingDef>
        <countRange>1~1</countRange>
      </li>


<!-- Animals -->
      <li Class="StockGenerator_Animals">
        <tradeTagsSell>
          <li>AnimalIsrael</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalUncommon</li>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>2~4</kindCountRange>
        <countRange>3~8</countRange>
      </li>


<!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Steel</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Plasteel</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Uranium</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Jade</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Cloth</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Wool</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Chemfuel</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>MusicalInstrument</tag></li>
