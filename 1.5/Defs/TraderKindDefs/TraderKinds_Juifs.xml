<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TraderKindDef ParentName="Base">
    <defName>Base_juifs</defName>
    <stockGenerators>

<!-- Ressources -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Gold</thingDef>
        <countRange>1000~2000</countRange>
      </li>


<!-- Food -->
      <li MayRequire="VanillaExpanded.VPlantsE" Class="StockGenerator_Category">
