<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <MemeDef>
    <defName>Geopol_Structure_OriginCommunism</defName>
    <label>Communisme</label>
    <description>Le communisme est une idéologie d'extrême gauche visant à l'abolition des classes sociales et de la propriété privée afin que tout appartienne à la communauté.</description>
    <category>Structure</category>
    <iconPath>Memes/communisme</iconPath>
    <impact>0</impact>
    <worshipRoomLabel>siège du parti communiste</worshipRoomLabel>
    <deityCount>0</deityCount>
    <consumableBuildings>
      <li>SacrificialFlag</li>
    </consumableBuildings>
    <renderOrder>-1</renderOrder>
    <generalRules>
      <rulesStrings>
        <li>memeLeaderNoun->secrétaire général</li>
        <li>memeLeaderAdjective->égalitaire</li>
        <li>memeMoralist->police de la pensée</li>
        <li>memeConcept->collectivisme</li>
        <li>memeConcept->égalitarisme</li>
	<li>memeAdjective->collectiviste</li>
	<li>memeAdjective->égal</li>
      </rulesStrings>
    </generalRules>
    <descriptionMaker>
      <patterns>
        <li>
          <def>IdeologicalFounder</def>
          <weight>1</weight>
        </li>
        <li>
          <def>IdeologicalLesson</def>
          <weight>3</weight>
        </li>
      </patterns>
      <constants>
        <li><key>structure_ideological</key><value>true</value></li>
      </constants>
    </descriptionMaker>
    <thingStyleCategories>
      <li>
        <category>Communisme</category>
        <priority>4</priority>
      </li>
    </thingStyleCategories>
    <symbolPacks>
      <li>
        <ideoName>Communisme</ideoName>
        <theme>communisme</theme>
        <adjective>Communiste</adjective>
        <member>Communiste</member>
      </li>
    </symbolPacks>
  </MemeDef>

  <SoundDef ParentName="RitualSustainerBase">
    <defName>RitualSustainer_Communisme</defName>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>styles/linternational</clipPath>
          </li>
        </grains>
        <volumeRange>30</volumeRange>
        <distRange>30~100</distRange>
        <sustainAttack>3</sustainAttack>
        <sustainSkipFirstAttack>False</sustainSkipFirstAttack>
      </li>
    </subSounds>
  </SoundDef>


</Defs>
