<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<success>Normal</success>
					<operations>
						<li Class="PatchOperationFindMod">
							<mods>
								<li>[K4G] PawnKind Extension</li>
							</mods>
							<match Class="PatchOperationSequence">
								<success>Normal</success>
								<operations>
						<li Class="PatchOperationAddModExtension">
							<xpath>*/PawnKindDef[defName="australian_civil" or defName="canada_civil" or defName="france_civil_1cc" or defName="france_civil_2c" or defName="france_civil_3c" or defName="france_civil_4c" or defName="russie_civil" or defName="sweden_civil" or defName="usa_civil"]</xpath>
							<value>
								<li Class="PawnKindExtension.PawnKindExtension">
							                <forcedHairs>
							                    <li>
                							        <styleTags>Civil_hair</styleTags>
              								        <spawnWeight>1</spawnWeight>
                        							<respectGenders>true</respectGenders>
							                    </li>
                							</forcedHairs>
                							<forcedBeards>
                    								<li>
        								                <styleTags>Civil_noBeard</styleTags>
								                        <spawnWeight>6</spawnWeight>
        								                <respectGenders>true</respectGenders>
                								</li>
                    								<li>
        								                <styleTags>Civil_beard</styleTags>
								                        <spawnWeight>1</spawnWeight>
        								                <respectGenders>true</respectGenders>
                								</li>
							                </forcedBeards>
								</li>
							</value>
						</li>
						<li Class="PatchOperationAddModExtension">
							<xpath>*/PawnKindDef[defName="france_civil_1c"]</xpath>
							<value>
								<li Class="PawnKindExtension.PawnKindExtension">
							                <forcedHairs>
							                    <li>
                							        <styleTags>Civil_hair</styleTags>
              								        <spawnWeight>1</spawnWeight>
                        							<respectGenders>true</respectGenders>
							                    </li>
                							</forcedHairs>
                							<forcedBeards>
                   								<li>
        								                <styleTags>France_beard</styleTags>
								                        <spawnWeight>2</spawnWeight>
        								                <respectGenders>true</respectGenders>
                								</li>
                    								<li>
        								                <styleTags>Civil_Beard</styleTags>
								                        <spawnWeight>1</spawnWeight>
        								                <respectGenders>true</respectGenders>
                								</li>
                    								<li>
        								                <styleTags>Civil_noBeard</styleTags>
								                        <spawnWeight>2</spawnWeight>
        								                <respectGenders>true</respectGenders>
                								</li>

							                </forcedBeards>
								</li>
							</value>
						</li>
						<li Class="PatchOperationAddModExtension">
							<xpath>*/PawnKindDef[defName="mexicain_civil"]</xpath>
							<value>
								<li Class="PawnKindExtension.PawnKindExtension">
							                <forcedHairs>
							                    <li>
                							        <styleTags>Civil_hair</styleTags>
              								        <spawnWeight>1</spawnWeight>
                        							<respectGenders>true</respectGenders>
							                    </li>
                							</forcedHairs>
                							<forcedBeards>
                    								<li>
        								                <styleTags>Civil_noBeard</styleTags>
								                        <spawnWeight>1</spawnWeight>
        								                <respectGenders>true</respectGenders>
                								</li>
                    								<li>
        								                <styleTags>Mexican_Beard</styleTags>
								                        <spawnWeight>1</spawnWeight>
        								                <respectGenders>true</respectGenders>
                								</li>
							                </forcedBeards>
								</li>
							</value>
						</li>
								</operations>
							</match>
						</li>
					</operations>
	</Operation>
</Patch>