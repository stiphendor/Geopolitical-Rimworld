<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationFindMod">
		<mods>
        <li>Ideology</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationRemove">
					<xpath>/Defs/MemeDef[defName="Individualist" or defName="Collectivist" or defName="FleshPurity" or defName="Rancher"]/styleItemTags</xpath>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Apparel_Flophat"]/apparel</xpath>
					<value>
						   <tags><li>EcoloBasic</li></tags>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/RitualObligationTargetFilterDef[defName="BurnTargets"]/thingDefs</xpath>
					<value>
						   <li>Crossklan</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>